# CLUSTER Society — Supabase Configuration
# Obtain these credentials from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# You can use either VITE_SUPABASE_PUBLISHABLE_KEY or VITE_SUPABASE_ANON_KEY (they are the same public key)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Production Site URL for QR Redirects
VITE_PRODUCTION_URL=https://cluster-club.vercel.app
